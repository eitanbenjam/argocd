              - "GROUP:Metrics/HealthCheck:devops_admin"
              - "GROUP:Metrics/HealthCheck:swcompil"
              - "GROUP:Metrics/ThreadDump:DevOps"
              - "GROUP:Metrics/ThreadDump:devops_admin"
              - "GROUP:Metrics/ThreadDump:swcompil"
              - "GROUP:Metrics/View:DevOps"
              - "GROUP:Metrics/View:devops_admin"
              - "GROUP:Metrics/View:swcompil"
              - "GROUP:Overall/Administer:DevOps"
              - "GROUP:Overall/Administer:admin"
              - "GROUP:Overall/Administer:devops_admin"
              - "GROUP:Overall/Read:DevOps"
              - "GROUP:Overall/Read:authenticated"
              - "GROUP:Overall/Read:devops_admin"
              - "GROUP:Overall/Read:swcompil"
              - "GROUP:Run/Delete:DevOps"
              - "GROUP:Run/Delete:devops_admin"
              - "GROUP:Run/Delete:swcompil"
              - "GROUP:Run/Replay:DevOps"
              - "GROUP:Run/Replay:devops_admin"
              - "GROUP:Run/Replay:swcompil"
