                containerCap: 64
                containerCapStr: "64"
                credentialsId: "microk8s-agents-jenkins-token"
                directConnection: true
                jenkinsUrl: "http://acc.radcom.co.il:8080"
                name: "Kubernetes cluster - microk8s - managed by DevOps"
                namespace: "jenkins-agents"
                serverCertificate: "${KUBERNETES_SERVER_CERTIFICATE}"
                serverUrl: "https://172.16.3.122:16443"
                skipTlsVerify: true
                templates:
                - containers:
                  - alwaysPullImage: true
                    image: "nexus3-prod.radcom.co.il:8084/rcc-rocky9-agent:1.3.3"
                    livenessProbe:
                      failureThreshold: 0
                      initialDelaySeconds: 0
                      periodSeconds: 0
                      successThreshold: 0
                      timeoutSeconds: 0
                    name: "jnlp"
                    workingDir: "/home/jenkins/agent"
                  - command: "/app/kubedock server -n jenkins-agents --inspector --image-pull-secrets\
                      \ nexus3-prod-8084 --reverse-proxy -v 10"
                    image: "nexus3-prod.radcom.co.il:8084/joyrex2001/kubedock:0.13.0"
                    livenessProbe:
                      failureThreshold: 0
                      initialDelaySeconds: 0
                      periodSeconds: 0
                      successThreshold: 0
                      timeoutSeconds: 0
                    name: "kubedock"
                    runAsGroup: "1000"
                    runAsUser: "1000"
                    ttyEnabled: true
                    workingDir: "/home/jenkins/agent"
                  - args: "3600"
                    command: "sleep"
                    image: "nexus3-prod.radcom.co.il:8084/gcr.io/kaniko-project/executor:v1.15.0-debug"
                    livenessProbe:
                      failureThreshold: 0
                      initialDelaySeconds: 0
                      periodSeconds: 0
                      successThreshold: 0
                      timeoutSeconds: 0
                    name: "kaniko"
                    ttyEnabled: true
                    workingDir: "/home/jenkins/agent"
                  - image: "nexus3-prod.radcom.co.il:8084/registry:2.8.2"
                    livenessProbe:
                      failureThreshold: 0
                      initialDelaySeconds: 0
                      periodSeconds: 0
                      successThreshold: 0
                      timeoutSeconds: 0
                    name: "registry"
                    workingDir: "/home/jenkins"
                  envVars:
                  - envVar:
                      key: "TESTCONTAINERS_RYUK_DISABLED"
                      value: "true"
                  - envVar:
                      key: "TESTCONTAINERS_CHECKS_DISABLE"
                      value: "true"
                  - envVar:
                      key: "DOCKER_HOST"
                      value: "tcp://172.16.3.134:2375"
                  - envVar:
                      key: "DOCKER_TLS_VERIFY"
                      value: "0"
                  - envVar:
                      key: "DOCKER_CONFIG"
                      value: "/kaniko/.docker/"
                  id: "194ae39c-f604-4408-b9a9-c78a83819c86"
                  imagePullSecrets:
                  - name: "nexus3-docker-cache-8087"
                  inheritFrom: "jenkins/jnlp-slave"
                  label: "RCC-ROCKY9-AGENT-K8S-JENKINS-ACC"
                  name: "RCC-ROCKY9-AGENT-K8S-JENKINS-ACC"
                  namespace: "jenkins-agents"
                  serviceAccount: "kubedock-sa"
                  volumes:
                  - secretVolume:
                      mountPath: "/kaniko/.docker/"
                      optional: false
                      secretName: "docker-config-json-secret"
                  yamlMergeStrategy: "override"
