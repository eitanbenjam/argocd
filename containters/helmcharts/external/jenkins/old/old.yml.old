              bindPassword: "${AD_BIND_PASSWORD}"
              cache:
                size: 256
                ttl: 600
              customDomain: true
              domains:
              - bindName: "CN=Jenkins,OU=R&D,OU=Groups,OU=RadCom,DC=radcom,DC=co,DC=il"
                bindPassword: "${AD_DOMAIN_BIND_PASSWORD}"
                name: "radcom.co.il"
                servers: "RDC01.radcom.co.il:3269"
                site: "optional-site"
                tlsConfiguration: TRUST_ALL_CERTIFICATES
              groupLookupStrategy: AUTO
              removeIrrelevantGroups: false
              requireTLS: true
              startTls: true
