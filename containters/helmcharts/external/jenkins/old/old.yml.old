              - "GROUP:SCM/Tag:authenticated"
              - "GROUP:SCM/Tag:devops_admin"
              - "GROUP:SCM/Tag:swcompil"
              - "USER:Agent/Build:moshe.dana"
              - "USER:Agent/Build:nicolae.rosia"
              - "USER:Agent/Configure:moshe.dana"
              - "USER:Agent/Configure:nicolae.rosia"
              - "USER:Agent/Connect:moshe.dana"
              - "USER:Agent/Connect:nicolae.rosia"
              - "USER:Agent/Create:moshe.dana"
              - "USER:Agent/Create:nicolae.rosia"
              - "USER:Agent/Delete:moshe.dana"
              - "USER:Agent/Delete:nicolae.rosia"
              - "USER:Agent/Disconnect:moshe.dana"
              - "USER:Agent/Disconnect:nicolae.rosia"
              - "USER:Artifactory/Promote:moshe.dana"
              - "USER:Artifactory/Promote:nicolae.rosia"
              - "USER:Artifactory/Release:moshe.dana"
              - "USER:Artifactory/Release:nicolae.rosia"
              - "USER:Credentials/Create:moshe.dana"
              - "USER:Credentials/Create:nicolae.rosia"
              - "USER:Credentials/Delete:moshe.dana"
              - "USER:Credentials/Delete:nicolae.rosia"
              - "USER:Credentials/ManageDomains:moshe.dana"
              - "USER:Credentials/ManageDomains:nicolae.rosia"
              - "USER:Credentials/Update:moshe.dana"
              - "USER:Credentials/Update:nicolae.rosia"
              - "USER:Credentials/View:ioseb.kuprashvili"
              - "USER:Credentials/View:moshe.dana"
              - "USER:Credentials/View:nicolae.rosia"
              - "USER:Job/Build:moshe.dana"
              - "USER:Job/Build:nicolae.rosia"
              - "USER:Job/Cancel:moshe.dana"
              - "USER:Job/Cancel:nicolae.rosia"
              - "USER:Job/Configure:moshe.dana"
              - "USER:Job/Configure:nicolae.rosia"
              - "USER:Job/Create:moshe.dana"
              - "USER:Job/Create:nicolae.rosia"
              - "USER:Job/Delete:moshe.dana"
              - "USER:Job/Delete:nicolae.rosia"
              - "USER:Job/Discover:moshe.dana"
              - "USER:Job/Discover:nicolae.rosia"
              - "USER:Job/Move:moshe.dana"
              - "USER:Job/Move:nicolae.rosia"
              - "USER:Job/Read:moshe.dana"
              - "USER:Job/Read:nicolae.rosia"
              - "USER:Job/ViewStatus:moshe.dana"
              - "USER:Job/ViewStatus:nicolae.rosia"
              - "USER:Job/Workspace:moshe.dana"
              - "USER:Job/Workspace:nicolae.rosia"
              - "USER:Lockable Resources/Reserve:moshe.dana"
              - "USER:Lockable Resources/Reserve:nicolae.rosia"
              - "USER:Lockable Resources/Steal:moshe.dana"
              - "USER:Lockable Resources/Steal:nicolae.rosia"
              - "USER:Lockable Resources/Unlock:moshe.dana"
              - "USER:Lockable Resources/Unlock:nicolae.rosia"
              - "USER:Lockable Resources/View:moshe.dana"
              - "USER:Lockable Resources/View:nicolae.rosia"
              - "USER:Metrics/HealthCheck:moshe.dana"
              - "USER:Metrics/HealthCheck:nicolae.rosia"
              - "USER:Metrics/ThreadDump:moshe.dana"
              - "USER:Metrics/ThreadDump:nicolae.rosia"
              - "USER:Metrics/View:moshe.dana"
              - "USER:Metrics/View:nicolae.rosia"
              - "USER:Overall/Administer:moshe.dana"
              - "USER:Overall/Administer:nicolae.rosia"
              - "USER:Overall/Read:ioseb.kuprashvili"
              - "USER:Overall/Read:moshe.dana"
              - "USER:Overall/Read:nicolae.rosia"
              - "USER:Promotion/Promote:moshe.dana"
              - "USER:Promotion/Promote:nicolae.rosia"
              - "USER:Run/Delete:moshe.dana"
              - "USER:Run/Delete:nicolae.rosia"
              - "USER:Run/Replay:moshe.dana"
              - "USER:Run/Replay:nicolae.rosia"
              - "USER:Run/Update:moshe.dana"
              - "USER:Run/Update:nicolae.rosia"
              - "USER:SCM/Tag:moshe.dana"
              - "USER:SCM/Tag:nicolae.rosia"
              - "USER:View/Configure:moshe.dana"
              - "USER:View/Configure:nicolae.rosia"
              - "USER:View/Create:moshe.dana"
              - "USER:View/Create:nicolae.rosia"
              - "USER:View/Delete:moshe.dana"
              - "USER:View/Delete:nicolae.rosia"
              - "USER:View/Read:moshe.dana"
              - "USER:View/Read:nicolae.rosia"
              - "GROUP:View/Configure:DevOps"
              - "GROUP:View/Configure:devops_admin"
              - "GROUP:View/Configure:swcompil"
              - "GROUP:View/Create:devops_admin"
              - "GROUP:View/Create:swcompil"
              - "GROUP:View/Delete:devops_admin"
              - "GROUP:View/Delete:swcompil"
              - "GROUP:View/Read:DevOps"
              - "GROUP:View/Read:authenticated"
              - "GROUP:View/Read:devops_admin"
              - "GROUP:View/Read:swcompil"
      configScripts:
        jenkins-casc-configs: |-
          credentials:
            system:
              domainCredentials:
              - credentials:
                - basicSSHUserPrivateKey:
                    description: "deployment-rsa"
                    id: "deployment-rsa"
                    privateKeySource:
                      directEntry:
                        privateKey: "${DEPLOYMENT_RSA_PRIVATE_KEY}"
                    scope: GLOBAL
                    username: "deployment"
                - basicSSHUserPrivateKey:
                    description: "jenkins-ci"
                    id: "gitsshkey"
                    privateKeySource:
                      directEntry:
                        privateKey: "${GITSSHKEY_PRIVATE_KEY}"
                    scope: GLOBAL
                    username: "jenkins-ci"
                - basicSSHUserPrivateKey:
                    description: "jenkins-ci"
                    id: "jenkins-ci"
                    privateKeySource:
                      directEntry:
                        privateKey: "${JENKINS_CI_PRIVATE_KEY}"
                    scope: GLOBAL
                    username: "jenkins-ci"
                - basicSSHUserPrivateKey:
                    description: "jenkins-ci-rsa"
                    id: "jenkins-ci-rsa"
                    privateKeySource:
                      directEntry:
                        privateKey: "${JENKINS_CI_RSA_PRIVATE_KEY}"
                    scope: GLOBAL
                    username: "jenkins-ci"
                - usernamePassword:
                    description: "legacy-omniqpp-slave-pass"
                    id: "legacy-omniqpp-slave-pass"
                    password: "${LEGACY_OMNIQPP_SLAVE_PASS}"
                    scope: GLOBAL
                    username: "root"
                - usernamePassword:
                    description: "nexus-admin"
                    id: "nexus-admin"
                    password: "${NEXUS_ADMIN_PASSWORD}"
                    scope: GLOBAL
                    username: "admin"
                - usernamePassword:
                    description: "radcomregistry-azure"
                    id: "radcomregistry-azure"
                    password: "${RADCOMREGISTRY_AZURE_PASSWORD}"
                    scope: GLOBAL
                    username: "radcomregistry"
                    usernameSecret: true
                - usernamePassword:
                    description: "RHOSP-01 Openstack User:Pass"
                    id: "rhosp-01-user-pass"
                    password: "${RHOSP_01_USER_PASS}"
                    scope: GLOBAL
                    username: "admin"
                - usernamePassword:
                    description: "RHOSPQA-01 Openstack User:Pass"
                    id: "rhospqa-01-user-pass"
                    password: "${RHOSPQA_01_USER_PASS}"
                    scope: GLOBAL
                    username: "admin"
                - string:
                    description: "The slack secret token"
                    id: "slack"
                    scope: GLOBAL
                    secret: "${SLACK_SECRET_TOKEN}"
                - usernamePassword:
                    description: "swcompil-user for svn"
                    id: "swcompil-user"
                    password: "${SWCOMPIL_USER_PASSWORD}"
                    scope: GLOBAL
                    username: "swcompil"
                - usernamePassword:
                    description: "Jenkins-master-password"
                    id: "Jenkins-master-password"
                    password: "${JENKINS_MASTER_PASSWORD}"
                    scope: GLOBAL
                    username: "root"
                - usernamePassword:
                    description: "rcc"
                    id: "rcc"
                    password: "${RCC_PASSWORD}"
                    scope: GLOBAL
                    username: "rcc"
                - usernamePassword:
                    description: "ace-developer"
                    id: "ace-developer"
                    password: "${ACE_DEVELOPER_PASSWORD}"
                    scope: GLOBAL
                    username: "ace-developer"
                    usernameSecret: true
                - usernamePassword:
                    description: "eks-user"
                    id: "eks-user"
                    password: "${EKS_USER_PASSWORD}"
                    scope: SYSTEM
                    username: "osboxes"
                    usernameSecret: true
                - aws:
                    accessKey: "${JENKINS_AWS_ACCESS_KEY}"
                    id: "jenkins_aws"
                    scope: GLOBAL
                    secretKey: "${JENKINS_AWS_SECRET_KEY}"
                    stsTokenDuration: 14400
                - usernamePassword:
                    description: "to download tenable io scanner latest"
                    id: "Tenable_io_login"
                    password: "${TENABLE_IO_LOGIN_PASSWORD}"
                    scope: GLOBAL
                    username: "pubread"
                    usernameSecret: true
                - usernamePassword:
                    description: "X-ApiKeys to access Tenable io"
                    id: "X-ApiKeys-Tenable-io"
                    password: "${X_APIKEYS_TENABLE_IO_PASSWORD}"
                    scope: GLOBAL
                    username: "${X_APIKEYS_TENABLE_IO_USERNAME}"
                    usernameSecret: true
                - file:
                    fileName: "1"
                    id: "eks_file"
                    scope: GLOBAL
                    secretBytes: "${EKS_FILE_SECRET_BYTES}"
                - usernamePassword:
                    description: "creds to run a CD job"
                    id: "radcom-cd"
                    password: "${RADCOM_CD_PASSWORD}"
                    scope: GLOBAL
                    username: "radcom-cd"
                    usernameSecret: true
                - file:
                    description: "DEPLOYMENTKEYRSA"
                    fileName: "deployment.key"
                    id: "DEPLOYMENTKEYRSA"
                    scope: GLOBAL
                    secretBytes: "${DEPLOYMENTKEYRSA_SECRET_BYTES}"
                - string:
                    description: "SonarQube API key"
                    id: "SonarQube-API-key"
                    scope: GLOBAL
                    secret: "${SONARQUBE_API_KEY}"
                - file:
                    description: ".npmrc file"
                    fileName: ".npmrc"
                    id: "NPMRC"
                    scope: GLOBAL
                    secretBytes: "${NPMRC_SECRET_BYTES}"
                - string:
                    id: "ORCA_SECURITY_API_TOKEN"
                    scope: GLOBAL
                    secret: "${ORCA_SECURITY_API_TOKEN}"
                - string:
                    description: "Jenkins Token for running jobs inside the DevOps microk8s\
                      \ cluster"
                    id: "microk8s-agents-jenkins-token"
                    scope: GLOBAL
                    secret: "${MICROK8S_AGENTS_JENKINS_TOKEN}"
                - aws:
                    accessKey: "${AWS_EKS_984565958963_JENKINS_USER_ACCESS_KEY}"
                    id: "aws-eks-984565958963-jenkins-user"
                    scope: GLOBAL
                    secretKey: "${AWS_EKS_984565958963_JENKINS_USER_SECRET_KEY}"
                - aws:
                    accessKey: "${RADCOM_SUBSCRIPTION_AWS_EKS_692859913461_JENKINS_USER_ACCESS_KEY}"
                    id: "radcom-subscription-aws-eks-692859913461-jenkins-user"
                    scope: GLOBAL
                    secretKey: "${RADCOM_SUBSCRIPTION_AWS_EKS_692859913461_JENKINS_USER_SECRET_KEY}"
                - string:
                    description: "Migrated from gitlab-branch-source-plugin webhook secret"
                    id: "7cd84bf4-ef74-4e28-989b-fb2f1bd387cf"
                    scope: GLOBAL
                    secret: "${GITLAB_BRANCH_SOURCE_PLUGIN_WEBHOOK_SECRET}"
                - file:
                    description: "kube_config file for OnPrem Isolation cluster"
                    fileName: "isolation-k0s.yaml"
                    id: "on-prem-microk8s-kube-config"
                    scope: GLOBAL
                    secretBytes: "${ON_PREM_MICROK8S_KUBE_CONFIG_SECRET_BYTES}"
                - usernamePassword:
                    id: "b3efc480-00a7-4398-8085-dd9efd64f1d0"
                    password: "${B3EFC480_00A7_4398_8085_DD9EFD64F1D0_PASSWORD}"
                    scope: GLOBAL
                    username: "apikey"
                    usernameSecret: true
                - usernamePassword:
                    id: "4857b008-c829-4fcb-b563-f3340abc8391"
                    password: "${4857B008_C829_4FCB_B563_F3340ABC8391_PASSWORD}"
                    scope: GLOBAL
                    username: "apikey"
                - aws:
                    accessKey: "${JENKINS_AWS_BEDC_ACCESS_KEY}"
                    id: "jenkins_aws_bedc"
                    scope: GLOBAL
                    secretKey: "${JENKINS_AWS_BEDC_SECRET_KEY}"
                - usernamePassword:
                    description: "var-admin"
                    id: "var-admin"
                    password: "${VAR_ADMIN_PASSWORD}"
                    scope: GLOBAL
                    username: "admin"
                - usernamePassword:
                    description: "base_repo"
                    id: "base_repo"
                    password: "${BASE_REPO_PASSWORD}"
                    scope: GLOBAL
                    username: "root"
                - file:
                    fileName: "isolation-k0s.yaml"
                    id: "on-prem-isolation-kubernetes-cluster-kubeconfig"
                    scope: GLOBAL
                    secretBytes: "${ON_PREM_ISOLATION_KUBERNETES_CLUSTER_KUBECONFIG_SECRET_BYTES}"
                - usernamePassword:
                    description: "jenkins-nexus"
                    id: "jenkins-nexus"
                    password: "${JENKINS_NEXUS_PASSWORD}"
                    scope: GLOBAL
                    username: "devops"
                - basicSSHUserPrivateKey:
                    description: "cots-rsa"
                    id: "cots-rsa"
                    privateKeySource:
                      directEntry:
                        privateKey: "${COTS_RSA_PRIVATE_KEY}"
                    scope: GLOBAL
                    username: "deployment"
                - usernamePassword:
                    id: "qauser"
                    password: "${QAUSER_PASSWORD}"
                    scope: GLOBAL
                    username: "qauser"
                - aws:
                    accessKey: "${JENKINS_AWS_RND_ACCESS_KEY}"
                    id: "jenkins_aws_rnd"
                    scope: GLOBAL
                    secretKey: "${JENKINS_AWS_RND_SECRET_KEY}"
                - usernamePassword:
                    description: "sftp-att-credentials"
                    id: "sftp-att-credentials"
                    password: "${SFTP_ATT_CREDENTIALS_PASSWORD}"
                    scope: GLOBAL
                    username: "ATT"
                - usernamePassword:
                    description: "radfs-user"
                    id: "radfs-user"
                    password: "${RADFS_USER_PASSWORD}"
                    scope: GLOBAL
                    username: "Jenkinsjob"
                - usernamePassword:
                    id: "apikey"
                    password: "${APIKEY_PASSWORD}"
                    scope: GLOBAL
                    username: "apikey"
                - basicSSHUserPrivateKey:
                    description: "aws-gitlab-radcom-us-east-2"
                    id: "aws-gitlab-radcom-us-east-2"
                    privateKeySource:
                      directEntry:
                        privateKey: "${AWS_GITLAB_RADCOM_US_EAST_2_PRIVATE_KEY}"
                    scope: GLOBAL
                    username: "marian.maireanu"
                - usernamePassword:
                    id: "aws-gitlab-radcom-us-east-2-username"
                    password: "${AWS_GITLAB_RADCOM_US_EAST_2_USERNAME_PASSWORD}"
                    scope: GLOBAL
                    username: "marian.maireanu"
                - file:
                    description: "GOVC-VSPHERE-DEVOPS"
                    fileName: "govc.env"
                    id: "GOVC-VSPHERE-DEVOPS"
                    scope: GLOBAL
                    secretBytes: "${GOVC_VSPHERE_DEVOPS_SECRET_BYTES}"
                - file:
                    description: "SARDINA4-admin-openrc"
                    fileName: "SARDINA4-admin-openrc"
                    id: "SARDINA4-admin-openrc"
                    scope: GLOBAL
                    secretBytes: "${SARDINA4_ADMIN_OPENRC_SECRET_BYTES}"
                - file:
                    description: "SARDINA3-admin-openrc"
                    fileName: "SARDINA3-admin-openrc"
                    id: "SARDINA3-admin-openrc"
                    scope: GLOBAL
                    secretBytes: "${SARDINA3_ADMIN_OPENRC_SECRET_BYTES}"
                - file:
                    description: "SARDINA2-admin-openrc"
                    fileName: "SARDINA2-admin-openrc"
                    id: "SARDINA2-admin-openrc"
                    scope: GLOBAL
                    secretBytes: "${SARDINA2_ADMIN_OPENRC_SECRET_BYTES}"
                - file:
                    description: "SARDINA1-admin-openrc"
                    fileName: "SARDINA1-admin-openrc"
                    id: "SARDINA1-admin-openrc"
                    scope: GLOBAL
                    secretBytes: "${SARDINA1_ADMIN_OPENRC_SECRET_BYTES}"
                - string:
                    id: "PACKER_GITHUB_API_TOKEN"
                    scope: GLOBAL
                    secret: "${PACKER_GITHUB_API_TOKEN}"
                - aws:
                    accessKey: "${JENKINS_AWS_PSOLABS_ACCESS_KEY}"
                    description: "010526251918 "
                    id: "jenkins_aws_psolabs"
                    scope: GLOBAL
                    secretKey: "${JENKINS_AWS_PSOLABS_SECRET_KEY}"
                - aws:
                    accessKey: "${JENKINS_AWS_NDC_ACCESS_KEY}"
                    description: "434721272023"
                    id: "jenkins_aws_ndc"
                    scope: GLOBAL
                    secretKey: "${JENKINS_AWS_NDC_SECRET_KEY}"
                - aws:
                    accessKey: "${JENKINS_AWS_RDC_ACCESS_KEY}"
                    description: "044224332302"
                    id: "jenkins_aws_rdc"
                    scope: GLOBAL
                    secretKey: "${JENKINS_AWS_RDC_SECRET_KEY}"
                - usernamePassword:
                    description: "url: vc-devops.lab.radcom.co.il"
                    id: "VSPHERE_DEVOPS_CREDENTIALS"
                    password: "${VSPHERE_DEVOPS_CREDENTIALS_PASSWORD}"
                    scope: GLOBAL
                    username: "devops-automation@vsphere.local"
                    usernameSecret: true
                - usernamePassword:
                    description: "url: vsandr-esxi01.radcom.co.il"
                    id: "VSPHERE_VSAN_DR_CREDENTIALS"
                    password: "${VSPHERE_VSAN_DR_CREDENTIALS_PASSWORD}"
                    scope: GLOBAL
                    username: "root"
                - usernamePassword:
                    description: "url: vcenterdr.radcom.co.il"
                    id: "VSPHERE_VCENTER_DR_CREDENTIALS"
                    password: "${VSPHERE_VCENTER_DR_CREDENTIALS_PASSWORD}"
                    scope: GLOBAL
                    username: "devopsAUTO@vsphere.local"
                - usernamePassword:
                    id: "ROCKY_ROOT_PASSWORD"
                    password: "${ROCKY_ROOT_PASSWORD}"
                    scope: GLOBAL
                    username: "root"
        global-node-properties: |-
          globalNodeProperties:
            - envVars:
                env:
                - key: "APPCYCLES_DEBUG_MODE"
                  value: "false"
                - key: "APPCYCLES_DEFAULT_JDK_TOOL_NAME"
                  value: "jdk"
                - key: "APPCYCLES_DEFAULT_MAVEN_SETTINGS_FILE_CONFIG_NAME"
                  value: "maven-settings"
                - key: "APPCYCLES_DEFAULT_MAVEN_TOOL_NAME"
                  value: "maven"
                - key: "APPCYCLES_PIPELINES_BRANCH"
                  value: "lts"
                - key: "JENKINS_HOSTNAME"
                  value: "RCC"
                - key: "RADCOM_PIPELINES_BRANCH"
                  value: "develop"
                - key: "RCC_PIPELINES_BRANCH"
                  value: "master"
        label-atoms: |-
          labelAtoms:
            - name: "CentOS7"
            - name: "InputAPI"
            - name: "InputAPI-test"
            - name: "RCC-ROCKY9-AGENT-K8S-JENKINS-ACC"
            - name: "RCCBaseAgent"
