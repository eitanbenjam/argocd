jenkins:
  controller:
    existingSecret: jenkins-credentials
    csrfdefaultCrumbIssuer:
      enabled: true
    JCasC:
      authorizationstrategy: |-
        jenkins:
          authorizationStrategy:
            projectMatrix:
              entries:
              - "GROUP:Agent/Build:DevOps"
              - "GROUP:Agent/Build:devops_admin"
              - "GROUP:Agent/Build:swcompil"
              - "GROUP:Agent/Configure:devops_admin"
              - "GROUP:Agent/Connect:DevOps"
              - "GROUP:Agent/Connect:devops_admin"
              - "GROUP:Agent/Connect:swcompil"
              - "GROUP:Agent/Create:devops_admin"
              - "GROUP:Agent/Create:swcompil"
              - "GROUP:Agent/Delete:devops_admin"
              - "GROUP:Agent/Delete:swcompil"
              - "GROUP:Agent/Disconnect:DevOps"
              - "GROUP:Agent/Disconnect:devops_admin"
              - "GROUP:Agent/Disconnect:swcompil"
              - "GROUP:Artifactory/Promote:DevOps"
              - "GROUP:Artifactory/Promote:devops_admin"
              - "GROUP:Artifactory/Promote:swcompil"
              - "GROUP:Artifactory/Release:DevOps"
              - "GROUP:Artifactory/Release:devops_admin"
              - "GROUP:Artifactory/Release:swcompil"
              - "GROUP:Credentials/Create:DevOps"
              - "GROUP:Credentials/Create:devops_admin"
              - "GROUP:Credentials/Create:swcompil"
              - "GROUP:Credentials/Delete:DevOps"
              - "GROUP:Credentials/Delete:devops_admin"
              - "GROUP:Credentials/Delete:swcompil"
              - "GROUP:Credentials/ManageDomains:DevOps"
              - "GROUP:Credentials/ManageDomains:devops_admin"
              - "GROUP:Credentials/ManageDomains:swcompil"
              - "GROUP:Credentials/Update:DevOps"
              - "GROUP:Credentials/Update:devops_admin"
              - "GROUP:Credentials/Update:swcompil"
              - "GROUP:Credentials/View:DevOps"
              - "GROUP:Credentials/View:devops_admin"
              - "GROUP:Credentials/View:swcompil"
              - "GROUP:Job/Build:DevOps"
              - "GROUP:Job/Build:authenticated"
              - "GROUP:Job/Build:devops_admin"
              - "GROUP:Job/Build:swcompil"
              - "GROUP:Job/Cancel:DevOps"
              - "GROUP:Job/Cancel:authenticated"
              - "GROUP:Job/Cancel:devops_admin"
              - "GROUP:Job/Cancel:swcompil"
              - "GROUP:Job/Configure:DevOps"
              - "GROUP:Job/Configure:devops_admin"
              - "GROUP:Job/Create:DevOps"
              - "GROUP:Job/Create:devops_admin"
              - "GROUP:Job/Delete:devops_admin"
              - "GROUP:Job/Discover:DevOps"
              - "GROUP:Job/Discover:authenticated"
              - "GROUP:Job/Discover:devops_admin"
              - "GROUP:Job/Discover:swcompil"
              - "GROUP:Job/Move:DevOps"
              - "GROUP:Job/Move:devops_admin"
              - "GROUP:Job/Read:DevOps"
              - "GROUP:Job/Read:authenticated"
              - "GROUP:Job/Read:devops_admin"
              - "GROUP:Job/Read:swcompil"
              - "GROUP:Job/ViewStatus:DevOps"
              - "GROUP:Job/ViewStatus:authenticated"
              - "GROUP:Job/ViewStatus:devops_admin"
              - "GROUP:Job/ViewStatus:swcompil"
              - "GROUP:Job/Workspace:DevOps"
              - "GROUP:Job/Workspace:authenticated"
              - "GROUP:Job/Workspace:devops_admin"
              - "GROUP:Job/Workspace:swcompil"
